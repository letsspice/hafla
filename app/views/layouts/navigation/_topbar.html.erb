<nav class="bg-black text-white shadow px-4 py-2 flex items-center justify-between text-sm rounded">
  <!-- Left: Logo -->
  <div class="flex items-center space-x-2">
    <%= link_to root_path, class: "font-bold" do %>
      <i class="fas fa-leaf text-green-500"></i>
      <span class="ml-1"><%= @organization.name %></span>
    <% end %>
  </div>

  <!-- Center: Search Bar -->
  <div class="flex-1 mx-4">
    <div class="max-w-md mx-auto">
      <div class="relative">
        <input type="text" placeholder="Search..." class="w-full bg-black text-white text-sm border border-gray-300 rounded-full pl-10 pr-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
        <div class="absolute left-3 top-2.5 text-gray-500">
          <i class="fas fa-search"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Right: Icons -->
  <div class="flex items-center space-x-4">
    <button class="text-gray-100 hover:text-primary focus:outline-none">
      <i class="fas fa-bell text-xl"></i>
    </button>
    <%= link_to "#", class: "text-gray-100  hover:text-primary focus:outline-none" do %>
      <i class="fas fa-user-circle text-2xl"></i>
    <% end %>
  </div>
</nav>