
<aside class="w-48 h-screen bg-gray-100 flex flex-col rounded-lg text-sm shadow">

  <!-- Navigation Links -->
  <nav class="flex-1 py-4  space-y-2">
    <%= link_to root_path, class: "flex items-center space-x-3 px-3 py-2 rounded hover:bg-gray-200" do %>
      <i class="fas fa-home"></i>
      <span>Dashboard</span>
    <% end %>

    <%= link_to "#", class: "flex items-center space-x-3 px-3 py-2 rounded hover:bg-gray-200" do %>
      <i class="fas fa-users"></i>
      <span>Users</span>
    <% end %>

    <%= link_to "#", class: "flex items-center space-x-3 px-3 py-2 rounded hover:bg-gray-200" do %>
      <i class="fas fa-cog"></i>
      <span>Settings</span>
    <% end %>
  </nav>

  <!-- Footer (Optional) -->
  <div class="p-4 border-t border-gray-700">
    <%= button_to destroy_user_session_path, method: :delete, class: "flex items-center space-x-3 hover:text-red-500" do %>
      <i class="fas fa-sign-out-alt"></i>
      <span>Logout</span>
    <% end %>
  </div>
</aside>
