<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-cache="false" class='border-2 border-red-500 px-6 py-3 mb-4 rounded-md bg-gray-50/80'>
    <ul class="text-red-500 list-disc pl-5 text-xs">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>