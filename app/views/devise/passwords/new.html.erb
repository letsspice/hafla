<div class="min-h-screen flex justify-center items-center">
  <div class="min-w-md mx-auto bg-white rounded-md md:px-10 px-2 md:py-5 py-3">
    <h1 class="text-3xl font-bold text-center mb-8">Forgot your password?</h1>
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
      <div class="flex flex-col space-y-1.5 md:px-16 px-4 md:py-8 py-2">
      </div>
      <div class="p-6 md:pt-0 pt-4">
        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>
          <div class="grid gap-4">
            <div class="space-y-2">
              <%= f.label :email, class:"label" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-field", placeholder: "john.doe@example.com", required: true %>
            </div>
            <%= f.submit "Send me reset password instructions", class: "primary-button" %>
          </div>
        <% end %>
      </div>
      <div class="p-6 pt-0 flex flex-col items-center gap-2">
         <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
<%= render "devise/shared/links" %>
