<div class="p-6 md:pt-0 pt-4" data-controller="location"> 
  <%= form_for @organization do |f| %>
    <%= render 'shared/errors', object: f.object %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Organization Name -->
      <div class="space-y-2">
        <%= f.label :name, class:"label" %>
        <%= f.text_field :name, autofocus: true, class: "input-field", placeholder: "The Lore KE", required: true %>
      </div>

      <!-- Organization Profile Fields -->
      <%= f.fields_for :organization_profile do |pf| %>
        <div class="space-y-2">
          <%= pf.label :country, class: "label" %>
          <%= pf.select :country, options_for_select(all_countries), {}, class: "input-field", data: { location_target: "country", action: "change->location#countryChanged" } %>
        </div>

        <div class="space-y-2">
          <%= pf.label :city, class: "label" %>
          <%= pf.select :city, [], {}, class: "input-field", data: { location_target: "city" } %>
        </div>
  
        <div class="space-y-2">
          <%= pf.label :currency, class: "label" %>
          <%= pf.select :currency, [], {}, class: "input-field", data: { location_target: "currency" } %>
        </div>
  
        <div class="space-y-2">
          <%= pf.label :timezone, class: "label" %>
          <%= pf.select :timezone, [], {}, class: "input-field", data: { location_target: "timezone" } %>
        </div>
  
        <div class="space-y-2">
          <%= pf.label :phone, class: "label" %>
          <div class="flex space-x-2">
            <select class="input-field w-1/3" data-location-target="phoneCode">
            </select>
            <%= pf.text_field :phone, class: "input-field w-2/3", required: true %>
          </div>
        </div>
      <% end %>

      <!-- Submit Button -->
      <div class="md:col-span-2">
        <%= f.submit "Submit", class: "primary-button w-full md:w-auto" %>
      </div>
    </div>
  <% end %>
</div>
