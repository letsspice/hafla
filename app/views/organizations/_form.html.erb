<%= form_for @organization do |f| %>
  <%= render 'shared/errors', object: f.object %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Organization Name -->
    <div class="space-y-2">
      <%= f.label :name, class:"label" %>
      <%= f.text_field :name, autofocus: true, class: "input-field", placeholder: "The Lore KE", required: true %>
    </div>

    <!-- Organization Profile Fields -->
    <%= f.fields_for :organization_profile do |pf| %>
      <div class="space-y-2">
        <%= pf.label :city, class: "label" %>
        <%= pf.text_field :city, class: "input-field", required: true %>
      </div>

      <div class="space-y-2">
        <%= pf.label :country, class: "label" %>
        <%= pf.text_field :country, class: "input-field", required: true %>
      </div>

      <div class="space-y-2">
        <%= pf.label :currency, class: "label" %>
        <%= pf.text_field :currency, class: "input-field", required: true %>
      </div>

      <div class="space-y-2">
        <%= pf.label :phone, class: "label" %>
        <%= pf.text_field :phone, class: "input-field", required: true %>
      </div>

      <div class="space-y-2">
        <%= pf.label :timezone, class: "label" %>
        <%= pf.text_field :timezone, class: "input-field", required: true %>
      </div>
    <% end %>

    <!-- Submit Button -->
    <div class="md:col-span-2">
      <%= f.submit "Submit", class: "primary-button w-full md:w-auto" %>
    </div>
  </div>
<% end %>
