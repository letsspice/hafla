<div class="bg-white rounded-xl shadow-sm p-6">
    <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-semibold text-gray-900">Period Events</h3>
    </div>

    <!-- Pie Chart -->
    <div class="relative w-36 h-32 mx-auto mb-4">
        <svg class="w-32 h-32 transform -rotate-90" viewBox="0 0 32 32">
            <!-- Background circle -->
            <circle cx="16" cy="16" r="15.915" fill="transparent" stroke="#e5e7eb" stroke-width="1"/>
            <!-- Purple segment (63%) -->
            <circle cx="16" cy="16" r="15.915" fill="transparent" stroke="#7c3aed" stroke-width="1"
                    stroke-dasharray="63 37" stroke-dashoffset="0"/>
            <!-- Light blue segment (25%) -->
            <circle cx="16" cy="16" r="15.915" fill="transparent" stroke="#60a5fa" stroke-width="1"
                    stroke-dasharray="25 75" stroke-dashoffset="-63"/>
            <!-- Dark blue segment (12%) -->
            <circle cx="16" cy="16" r="15.915" fill="transparent" stroke="#1e40af" stroke-width="1"
                    stroke-dasharray="12 88" stroke-dashoffset="-88"/>
        </svg>
        <div class="absolute inset-0 flex items-center justify-center">
            <div class="text-center">
            <div class="text-lg font-bold text-purple-600">63%</div>
            <div class="text-xs text-gray-500">Camp Rock</div>
            </div>
        </div>
    </div>

    <!-- Legend -->
    <div class="space-y-2 text-sm">
        <div class="flex items-center justify-between">
            <div class="flex items-center">
            <div class="w-3 h-3 bg-purple-600 rounded-full mr-2"></div>
            <span>Camp Rock</span>
            </div>
            <span class="font-medium">63%</span>
        </div>
        <div class="flex items-center justify-between">
            <div class="flex items-center">
            <div class="w-3 h-3 bg-blue-400 rounded-full mr-2"></div>
            <span>TTPO Anniversary</span>
            </div>
            <span class="font-medium">25%</span>
        </div>
        <div class="flex items-center justify-between">
            <div class="flex items-center">
            <div class="w-3 h-3 bg-blue-800 rounded-full mr-2"></div>
            <span>Nairobi Hold Em</span>
            </div>
            <span class="font-medium">12%</span>
        </div>
    </div>
</div>