<div class="max-w-4xl mx-auto text-xs">
  <!-- Logos Section -->
  <div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
    <div class="mb-6">
      <h2 class="text-sm font-semibold text-gray-900 mb-2">Logo</h2>
      <p class="text-sm text-gray-600">Used for most common logo applications</p>
    </div>

    <!-- Default Logo -->
    <div class="mb-8">
      <h3 class="text-sm font-medium text-gray-900 mb-3">Default</h3>
      <div class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-lg p-6 mb-4">
        <div class="flex items-center justify-center h-32">
          <% if @organization.organization_brand_asset&.logo&.attached? %>
            <%= image_tag @organization.organization_brand_asset.logo, class: "max-h-full max-w-full object-contain" %>
          <% else %>
            <div class="text-center">
              <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <p class="mt-2 text-sm text-gray-600">No logo uploaded</p>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="flex space-x-3 mb-3">
        <button type="button" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
          Change
        </button>
        <button type="button" class="bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
          Remove
        </button>
      </div>
      
      <p class="text-xs text-gray-500">HEIC, WEBP, SVG, PNG, or JPG. Recommended width: 512 pixels minimum.</p>
    </div>
  </div>

  <!-- Cover Image Section -->
  <div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
    <div class="mb-6">
      <h2 class="text-sm font-semibold text-gray-900 mb-2">Cover Image</h2>
      <p class="text-sm text-gray-600">Used for social media and marketing materials</p>
    </div>

    <div class="bg-gray-50 border-2 border-dashed border-gray-300 rounded-lg p-6 mb-4">
      <div class="flex items-center justify-center h-48">
        <% if @organization.organization_brand_asset&.cover_image&.attached? %>
          <%= image_tag @organization.organization_brand_asset.cover_image, class: "max-h-full max-w-full object-cover rounded" %>
        <% else %>
          <div class="text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
              <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <p class="mt-2 text-sm text-gray-600">No cover image uploaded</p>
          </div>
        <% end %>
      </div>
    </div>
    
    <div class="flex space-x-3 mb-3">
      <button type="button" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
        Change
      </button>
      <button type="button" class="bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
        Remove
      </button>
    </div>
    
    <p class="text-xs text-gray-500">HEIC, WEBP, SVG, PNG, or JPG. Recommended: 1200x630 pixels minimum.</p>
  </div>

  <!-- Brand Colors Section -->
  <div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
    <div class="mb-6">
      <h2 class="text-sm font-semibold text-gray-900 mb-2">Colors</h2>
      <p class="text-sm text-gray-600">The brand colors that appear on your store, social media, and more</p>
    </div>

    <!-- Primary Colors Section -->
    <div class="mb-8">
      <h3 class="text-sm font-medium text-gray-900 mb-4">Primary</h3>
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <div class="relative group">
              <div class="w-12 h-12 rounded border border-gray-300 bg-blue-500 cursor-pointer hover:ring-2 hover:ring-blue-300 transition-all duration-200" 
                   style="background-color: <%= @organization.organization_brand_asset&.primary_color || '#3B82F6' %>"
                   data-color-type="primary"
                   data-current-color="<%= @organization.organization_brand_asset&.primary_color || '#3B82F6' %>">
              </div>
              <div class="absolute bottom-0 left-0 w-3 h-3 bg-white rounded-full border border-gray-300"></div>
              
              <!-- Custom Color Picker Popup -->
              <div class="absolute top-full left-0 mt-2 bg-white border border-gray-200 rounded-lg shadow-lg p-4 z-10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 w-80">
                <div class="flex items-center space-x-3 mb-4">
                  <div class="w-8 h-8 rounded border border-gray-300" style="background-color: <%= @organization.organization_brand_asset&.primary_color || '#3B82F6' %>"></div>
                  <div>
                    <p class="text-xs font-medium text-gray-900">Primary color</p>
                    <p class="text-xs text-gray-500 font-mono"><%= @organization.organization_brand_asset&.primary_color || '#3B82F6' %></p>
                  </div>
                </div>
                
                <!-- Custom Color Picker -->
                <div class="space-y-4">
                  <!-- Main Color Selection Area -->
                  <div class="relative">
                    <div class="w-full h-32 bg-gradient-to-br from-white via-blue-400 to-black rounded cursor-crosshair" 
                         data-action="mousedown->settings#startColorDrag"
                         data-color-type="primary">
                      <div class="absolute w-3 h-3 bg-white border-2 border-gray-800 rounded-full cursor-move" 
                           style="left: 70%; top: 30%;"
                           data-settings-target="primaryColorHandle"></div>
                    </div>
                  </div>
                  
                  <!-- Hue Slider and Current Color -->
                  <div class="flex items-center space-x-3">
                    <div class="w-6 h-6 bg-gray-200 rounded flex items-center justify-center">
                      <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z"></path>
                      </svg>
                    </div>
                    <div class="w-8 h-8 rounded-full border-2 border-gray-300" style="background-color: <%= @organization.organization_brand_asset&.primary_color || '#3B82F6' %>"></div>
                    <div class="flex-1 h-6 bg-gradient-to-r from-red-500 via-yellow-500 via-green-500 via-blue-500 via-purple-500 to-red-500 rounded cursor-pointer relative"
                         data-action="click->settings#selectHue"
                         data-color-type="primary">
                      <div class="absolute w-3 h-3 bg-white border-2 border-gray-800 rounded-full -top-1" 
                           style="left: 60%;"
                           data-settings-target="primaryHueHandle"></div>
                    </div>
                  </div>
                  
                  <!-- Color Input Fields -->
                  <div class="space-y-3">
                    <!-- Hex Code Input -->
                    <div>
                      <label class="block text-xs text-gray-600 mb-1">Hex Code</label>
                      <input type="text" 
                             class="w-full text-xs border border-gray-300 rounded px-2 py-1 text-center font-mono"
                             value="<%= @organization.organization_brand_asset&.primary_color || '#3B82F6' %>"
                             data-action="input->settings#updateHex"
                             data-color-type="primary"
                             placeholder="#3B82F6">
                    </div>
                    
                    <!-- RGB Input Fields -->
                    <div class="grid grid-cols-3 gap-3">
                      <div>
                        <label class="block text-xs text-gray-600 mb-1">R</label>
                        <input type="number" min="0" max="255" value="59" 
                               class="w-full text-xs border border-gray-300 rounded px-2 py-1 text-center"
                               data-action="input->settings#updateRGB"
                               data-color-type="primary"
                               data-rgb="r">
                      </div>
                      <div>
                        <label class="block text-xs text-gray-600 mb-1">G</label>
                        <input type="number" min="0" max="255" value="130" 
                               class="w-full text-xs border border-gray-300 rounded px-2 py-1 text-center"
                               data-action="input->settings#updateRGB"
                               data-color-type="primary"
                               data-rgb="g">
                      </div>
                      <div>
                        <label class="block text-xs text-gray-600 mb-1">B</label>
                        <input type="number" min="0" max="255" value="246" 
                               class="w-full text-xs border border-gray-300 rounded px-2 py-1 text-center"
                               data-action="input->settings#updateRGB"
                               data-color-type="primary"
                               data-rgb="b">
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-900">Primary color</p>
              <p class="text-sm text-gray-500 font-mono" data-settings-target="primaryColorHex"><%= @organization.organization_brand_asset&.primary_color || '#3B82F6' %></p>
            </div>
          </div>
          <button type="button" class="text-red-600 hover:text-red-700 text-sm font-medium">Remove</button>
        </div>
      </div>
    </div>

    <!-- Secondary Colors Section -->
    <div>
      <h3 class="text-sm font-medium text-gray-900 mb-4">Secondary</h3>
      <p class="text-sm text-gray-600 mb-4">Supporting colors used for accents and additional detail</p>
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-4">
            <div class="relative group">
              <div class="w-12 h-12 rounded border border-gray-300 bg-purple-500 cursor-pointer hover:ring-2 hover:ring-blue-300 transition-all duration-200" 
                   style="background-color: <%= @organization.organization_brand_asset&.secondary_color || '#8B5CF6' %>"
                   data-color-type="secondary"
                   data-current-color="<%= @organization.organization_brand_asset&.secondary_color || '#8B5CF6' %>">
              </div>
              <div class="absolute bottom-0 left-0 w-3 h-3 bg-white rounded-full border border-gray-300"></div>
              
              <!-- Custom Color Picker Popup -->
              <div class="absolute top-full left-0 mt-2 bg-white border border-gray-200 rounded-lg shadow-lg p-4 z-10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 w-80">
                <div class="flex items-center space-x-3 mb-4">
                  <div class="w-8 h-8 rounded border border-gray-300" style="background-color: <%= @organization.organization_brand_asset&.secondary_color || '#8B5CF6' %>"></div>
                  <div>
                    <p class="text-xs font-medium text-gray-900">Secondary color 1</p>
                    <p class="text-xs text-gray-500 font-mono"><%= @organization.organization_brand_asset&.secondary_color || '#8B5CF6' %></p>
                  </div>
                </div>
                
                <!-- Custom Color Picker -->
                <div class="space-y-4">
                  <!-- Main Color Selection Area -->
                  <div class="relative">
                    <div class="w-full h-32 bg-gradient-to-br from-white via-purple-400 to-black rounded cursor-crosshair" 
                         data-action="mousedown->settings#startColorDrag"
                         data-color-type="secondary">
                      <div class="absolute w-3 h-3 bg-white border-2 border-gray-800 rounded-full cursor-move" 
                           style="left: 70%; top: 30%;"
                           data-settings-target="secondaryColorHandle"></div>
                    </div>
                  </div>
                  
                  <!-- Hue Slider and Current Color -->
                  <div class="flex items-center space-x-3">
                    <div class="w-6 h-6 bg-gray-200 rounded flex items-center justify-center">
                      <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z"></path>
                      </svg>
                    </div>
                    <div class="w-8 h-8 rounded-full border-2 border-gray-300" style="background-color: <%= @organization.organization_brand_asset&.secondary_color || '#8B5CF6' %>"></div>
                    <div class="flex-1 h-6 bg-gradient-to-r from-red-500 via-yellow-500 via-green-500 via-blue-500 via-purple-500 to-red-500 rounded cursor-pointer relative"
                         data-action="click->settings#selectHue"
                         data-color-type="secondary">
                      <div class="absolute w-3 h-3 bg-white border-2 border-gray-800 rounded-full -top-1" 
                           style="left: 80%;"
                           data-settings-target="secondaryHueHandle"></div>
                    </div>
                  </div>
                  
                  <!-- Color Input Fields -->
                  <div class="space-y-3">
                    <!-- Hex Code Input -->
                    <div>
                      <label class="block text-xs text-gray-600 mb-1">Hex Code</label>
                      <input type="text" 
                             class="w-full text-xs border border-gray-300 rounded px-2 py-1 text-center font-mono"
                             value="<%= @organization.organization_brand_asset&.secondary_color || '#8B5CF6' %>"
                             data-action="input->settings#updateHex"
                             data-color-type="secondary"
                             placeholder="#8B5CF6">
                    </div>
                    
                    <!-- RGB Input Fields -->
                    <div class="grid grid-cols-3 gap-3">
                      <div>
                        <label class="block text-xs text-gray-600 mb-1">R</label>
                        <input type="number" min="0" max="255" value="139" 
                               class="w-full text-xs border border-gray-300 rounded px-2 py-1 text-center"
                               data-action="input->settings#updateRGB"
                               data-color-type="secondary"
                               data-rgb="r">
                      </div>
                      <div>
                        <label class="block text-xs text-gray-600 mb-1">G</label>
                        <input type="number" min="0" max="255" value="92" 
                               class="w-full text-xs border border-gray-300 rounded px-2 py-1 text-center"
                               data-action="input->settings#updateRGB"
                               data-color-type="secondary"
                               data-rgb="g">
                      </div>
                      <div>
                        <label class="block text-xs text-gray-600 mb-1">B</label>
                        <input type="number" min="0" max="255" value="246" 
                               class="w-full text-xs border border-gray-300 rounded px-2 py-1 text-center"
                               data-action="input->settings#updateRGB"
                               data-color-type="secondary"
                               data-rgb="b">
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div>
              <p class="text-sm font-medium text-gray-900">Secondary color 1</p>
              <p class="text-sm text-gray-500 font-mono" data-settings-target="secondaryColorHex"><%= @organization.organization_brand_asset&.secondary_color || '#8B5CF6' %></p>
            </div>
          </div>
          <button type="button" class="text-red-600 hover:text-red-700 text-sm font-medium">Remove</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Slogan Section -->
  <div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
    <div class="mb-6">
      <h2 class="text-sm font-semibold text-gray-900 mb-2">Slogan</h2>
      <p class="text-sm text-gray-600">Your organization's tagline or mission statement</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Organization Slogan</label>
      <textarea 
        class="w-full text-sm border border-gray-300 rounded px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" 
        rows="3" 
        placeholder="Enter your organization's slogan or tagline..."
      ><%= @organization.organization_brand_asset&.slogan %></textarea>
      <p class="text-xs text-gray-500 mt-1">Keep it concise and memorable. This will be displayed alongside your logo in various applications.</p>
    </div>
  </div>

  <!-- Description Section -->
  <div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
    <div class="mb-6">
      <h2 class="text-sm font-semibold text-gray-900 mb-2">Description</h2>
      <p class="text-sm text-gray-600">A detailed description of your organization</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-2">Organization Description</label>
      <textarea 
        class="w-full text-sm border border-gray-300 rounded px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" 
        rows="6" 
        placeholder="Describe your organization, its mission, values, and what makes it unique..."
      ><%= @organization.organization_brand_asset&.description %></textarea>
      <p class="text-xs text-gray-500 mt-1">This description will be used in marketing materials, social media profiles, and other brand communications.</p>
    </div>
  </div>

  <!-- Social Links Section -->
  <div class="bg-white rounded-lg border border-gray-200 p-6 mb-6">
    <div class="mb-6">
      <h2 class="text-xl font-semibold text-gray-900 mb-2">Social links</h2>
      <p class="text-sm text-gray-600">Social links for your business, often used in the theme footer</p>
    </div>

    <!-- Add Social Link Button -->
    <div class="mb-6 relative" data-controller="dropdown">
      <button type="button" 
              class="bg-white border border-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 flex items-center space-x-2"
              data-action="click->dropdown#toggle">
        <span>Add social link</span>
        <svg class="w-4 h-4 transition-transform duration-200" 
             data-dropdown-target="icon"
             fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
      
      <!-- Dropdown Menu -->
      <div class="absolute top-full left-0 mt-1 w-64 bg-white border border-gray-200 rounded-md shadow-lg z-20 opacity-0 invisible transition-all duration-200 max-h-80 overflow-y-auto"
           data-dropdown-target="menu">
        
        <!-- Instagram -->
        <button type="button" class="w-full flex items-center space-x-3 px-4 py-3 text-left hover:bg-gray-50 border-b border-gray-100 last:border-b-0"
                data-action="click->dropdown#selectSocialLink"
                data-platform="instagram">
          <div class="w-5 h-5 bg-gradient-to-br from-purple-600 to-pink-600 rounded-full flex items-center justify-center">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4z"/>
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-900">Instagram</span>
        </button>

        <!-- LinkedIn -->
        <button type="button" class="w-full flex items-center space-x-3 px-4 py-3 text-left hover:bg-gray-50 border-b border-gray-100 last:border-b-0"
                data-action="click->dropdown#selectSocialLink"
                data-platform="linkedin">
          <div class="w-5 h-5 bg-blue-600 rounded flex items-center justify-center">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.047-1.852-3.047-1.853 0-2.136 1.445-2.136 2.939v5.677H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <span class="text-sm font-medium text-gray-900">LinkedIn</span>
        </button>

        <!-- Pinterest -->
        <button type="button" class="w-full flex items-center space-x-3 px-4 py-3 text-left hover:bg-gray-50 border-b border-gray-100 last:border-b-0"
                data-action="click->dropdown#selectSocialLink"
                data-platform="pinterest">
          <div class="w-5 h-5 bg-red-600 rounded flex items-center justify-center">
            <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 24 24">
