            </svg>
          </div>
          <span class="text-sm font-medium text-gray-900">Discord</span>
        </button>
      </div>
    </div>

    <!-- Social Media Links -->
    <div class="space-y-6">
      <!-- Facebook -->
      <div class="flex items-start justify-between">
        <div class="flex-1">
          <label class="block text-sm font-medium text-gray-900 mb-2">Facebook</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </div>
            <input type="url" 
                   class="w-full text-sm border border-gray-300 rounded-md pl-10 pr-3 py-2" 
                   placeholder="https://facebook.com/shopify"
                   value="<%= @organization.organization_brand_asset&.facebook_url %>">
          </div>
        </div>
        <button type="button" class="ml-4 text-red-600 hover:text-red-700 text-sm font-medium mt-8">Remove</button>
      </div>

      <!-- X (Twitter) -->
      <div class="flex items-start justify-between">
        <div class="flex-1">
          <label class="block text-sm font-medium text-gray-900 mb-2">X</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-900" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </div>
            <input type="url" 
                   class="w-full text-sm border border-gray-300 rounded-md pl-10 pr-3 py-2" 
                   placeholder="https://x.com/shopify"
                   value="<%= @organization.organization_brand_asset&.twitter_url %>">
          </div>
        </div>
        <button type="button" class="ml-4 text-red-600 hover:text-red-700 text-sm font-medium mt-8">Remove</button>
      </div>

      <!-- TikTok -->
      <div class="flex items-start justify-between">
        <div class="flex-1">
          <label class="block text-sm font-medium text-gray-900 mb-2">TikTok</label>
