
<aside class="w-64 h-screen bg-gray-800 text-white flex flex-col">
  <!-- Logo -->
  <div class="p-4 flex items-center space-x-2 text-white text-base font-semibold border-b border-gray-700">
    <i class="fas fa-leaf text-green-400"></i>
    <span><%= @organization.name %></span>
  </div>

  <!-- Navigation Links -->
  <nav class="flex-1 p-4 space-y-2">
    <%= link_to root_path, class: "flex items-center space-x-3 px-3 py-2 rounded hover:bg-gray-700" do %>
      <i class="fas fa-home"></i>
      <span>Dashboard</span>
    <% end %>

    <%= link_to "#", class: "flex items-center space-x-3 px-3 py-2 rounded hover:bg-gray-700" do %>
      <i class="fas fa-users"></i>
      <span>Users</span>
    <% end %>

    <%= link_to "#", class: "flex items-center space-x-3 px-3 py-2 rounded hover:bg-gray-700" do %>
      <i class="fas fa-cog"></i>
      <span>Settings</span>
    <% end %>
  </nav>

  <!-- Footer (Optional) -->
  <div class="p-4 border-t border-gray-700">
    <%= link_to "#", class: "flex items-center space-x-3 text-sm text-gray-400 hover:text-white" do %>
      <i class="fas fa-sign-out-alt"></i>
      <span>Logout</span>
    <% end %>
  </div>
</aside>
